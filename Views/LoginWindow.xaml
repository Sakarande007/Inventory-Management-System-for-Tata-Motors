<Window x:Class="PaintShopIMS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paint Shop IMS Login" Height="1080" Width="1920" WindowState="Maximized" WindowStyle="SingleBorderWindow" Background="{StaticResource NavyDarkBrush}">
    
    <Grid>
        <!-- Centered Card -->
        <Border Style="{StaticResource CardBorder}" Width="360" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Margin="20">
                
                <!-- Logo text -->
                <TextBlock Text="Paint Shop IMS" FontSize="{StaticResource TitleSize}" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                
                <!-- Error Message -->
                <Label x:Name="lblError" Content="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Visibility="{Binding ErrorMessage, Converter={StaticResource StringLengthToVisibilityConverter}}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <!-- Username -->
                <TextBlock Text="Username" Style="{StaticResource ModernTextBlock}" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsername" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                <!-- Password -->
                <TextBlock Text="Password" Style="{StaticResource ModernTextBlock}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBox}" PasswordChanged="OnPasswordChanged" Margin="0,0,0,30"/>

                <!-- Login Button -->
                <Button Content="LOGIN" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButton}" Height="40" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
