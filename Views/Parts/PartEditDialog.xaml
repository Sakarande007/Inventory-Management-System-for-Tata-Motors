<Window x:Class="PaintShopIMS.Views.Parts.PartEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="400" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource LightBgBrush}">
    
    <Border Style="{StaticResource CardBorder}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Title}" FontSize="{StaticResource TitleSize}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Grid.Row="0" Margin="0,0,0,20"/>
            
            <StackPanel Grid.Row="1">
                <!-- Part No -->
                <TextBlock Text="Part No *" Style="{StaticResource ModernTextBlock}" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPartNo" Text="{Binding PartNo, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsPartNoReadOnly}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding ValidationErrors[PartNo]}" Foreground="{StaticResource DangerBrush}" FontSize="{StaticResource CaptionSize}" Margin="0,0,0,10" Visibility="{Binding ValidationErrors[PartNo], Converter={StaticResource StringLengthToVisibilityConverter}, FallbackValue=Collapsed}"/>

                <!-- Part Name -->
                <TextBlock Text="Part Name *" Style="{StaticResource ModernTextBlock}" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPartName" Text="{Binding PartName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding ValidationErrors[PartName]}" Foreground="{StaticResource DangerBrush}" FontSize="{StaticResource CaptionSize}" Margin="0,0,0,10" Visibility="{Binding ValidationErrors[PartName], Converter={StaticResource StringLengthToVisibilityConverter}, FallbackValue=Collapsed}"/>

                <!-- Description -->
                <TextBlock Text="Description" Style="{StaticResource ModernTextBlock}" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtDescription" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>
                
                <!-- Remark -->
                <TextBlock Text="Remark" Style="{StaticResource ModernTextBlock}" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtRemark" Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>
            </StackPanel>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                <Button Content="Save" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
