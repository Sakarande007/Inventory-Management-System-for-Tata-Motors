<UserControl x:Class="PaintShopIMS.Views.Scan.InwardScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PaintShopIMS.Views.Scan"
             Loaded="UserControl_Loaded" Background="Transparent"
             d:DesignHeight="600" d:DesignWidth="800"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
             

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Scan Card -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Scan Barcode (Inward)" FontSize="{StaticResource TitleSize}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="Format: PartNo|YYYY-MM-DD|SerialNumber" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,15"/>
                
                <TextBox x:Name="_txtScan" Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}" KeyDown="TxtScan_KeyDown" Style="{StaticResource ModernTextBox}" Height="50" FontSize="14" FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <CheckBox Content="Is Rework?" IsChecked="{Binding IsRework}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Margin="0,0,20,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <ComboBox ItemsSource="{Binding DefectList}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding SelectedDefectCode}" 
                              Width="200" Visibility="{Binding IsRework, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ModernComboBox}"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,15,0,0" Visibility="{Binding HasGeneratedQr, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Rework QR Generated:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Image Source="{Binding GeneratedQrImage}" Width="150" Height="150" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Animated Status Label -->
                <TextBlock x:Name="lblStatus" Text="{Binding StatusMessage, NotifyOnTargetUpdated=True}" Style="{StaticResource StatusLabel}" Margin="0,15,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringLengthToVisibilityConverter}}">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Summary Row -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="{StaticResource SectionSize}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                <Run Text="Today's scans: "/>
                <Run Text="{Binding TodayCount}"/>
            </TextBlock>
            <Button Grid.Column="1" Content="Delete" Style="{StaticResource DangerButton}" 
                    Command="{Binding DeleteInwardCommand}" 
                    IsEnabled="{Binding SelectedInwardItem, Converter={StaticResource NullToBoolConverter}}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- Recent Scans DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <DataGrid ItemsSource="{Binding RecentScans}" SelectedItem="{Binding SelectedInwardItem, Mode=TwoWay}" Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Part No" Binding="{Binding PartNo}" Width="150"/>
                    <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="200"/>
                    <DataGridTextColumn Header="Rework Code" Binding="{Binding DefectCode}" Width="120"/>
                    <DataGridTextColumn Header="Scan Date" Binding="{Binding ScanDate}" Width="150"/>
                    <DataGridTextColumn Header="Scanned By" Binding="{Binding ScannedBy}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
