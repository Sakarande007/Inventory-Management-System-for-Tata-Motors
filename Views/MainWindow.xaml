<Window x:Class="PaintShopIMS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PaintShopIMS.ViewModels"
        xmlns:dashboard="clr-namespace:PaintShopIMS.Views.Dashboard"
        xmlns:scan="clr-namespace:PaintShopIMS.Views.Scan"
        xmlns:parts="clr-namespace:PaintShopIMS.Views.Parts"
        xmlns:customers="clr-namespace:PaintShopIMS.Views.Customers"
        xmlns:reports="clr-namespace:PaintShopIMS.Views.Reports"
        Title="Paint Shop IMS" Height="1080" Width="1920" WindowState="Maximized" WindowStyle="SingleBorderWindow" Background="{StaticResource LightBgBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <dashboard:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InwardScanViewModel}">
            <scan:InwardScanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OutwardScanViewModel}">
            <scan:OutwardScanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PartMasterViewModel}">
            <parts:PartMasterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomerMasterViewModel}">
            <customers:CustomerMasterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <reports:ReportsView />
        </DataTemplate>

        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource NavyDarkBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource NavyMidBrush}" Padding="20">
                    <TextBlock Text="INVENTORY IMS" FontSize="{StaticResource TitleSize}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </Border>

                <!-- Nav Buttons -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <Button Content="Dashboard" Command="{Binding NavigateToCommand}" CommandParameter="Dashboard" Style="{StaticResource NavButton}"/>
                    <Button Content="Inward Scan" Command="{Binding NavigateToCommand}" CommandParameter="Inward" Style="{StaticResource NavButton}"/>
                    <Button Content="Outward Scan" Command="{Binding NavigateToCommand}" CommandParameter="Outward" Style="{StaticResource NavButton}"/>
                    
                    <Border Height="1" Background="{StaticResource NavyMidBrush}" Margin="20,10,20,10" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="Part Master" Command="{Binding NavigateToCommand}" CommandParameter="Parts" Style="{StaticResource NavButton}" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="Customers" Command="{Binding NavigateToCommand}" CommandParameter="Customers" Style="{StaticResource NavButton}" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="Reports" Command="{Binding NavigateToCommand}" CommandParameter="Reports" Style="{StaticResource NavButton}" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Footer Logged In -->
                <StackPanel Grid.Row="2" Margin="20" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Username}" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Button Content="Logout" Command="{Binding LogoutCommand}" Style="{StaticResource GhostButton}" Foreground="White" BorderBrush="{StaticResource DangerBrush}" Height="30" Width="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="{StaticResource CardWhiteBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <TextBlock Text="{Binding CurrentPageTitle}" FontSize="{StaticResource TitleSize}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="txtLiveClock" FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Content Area mapping ViewModel to Views via Resources -->
            <ContentControl x:Name="contentControl" Grid.Row="1" Content="{Binding CurrentView}" Margin="20">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
