<UserControl x:Class="PaintShopIMS.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded" Background="Transparent"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Inward/Outward Pill Template -->
        <DataTemplate x:Key="TypeColumnTemplate">
            <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#EAF3DE"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="OUTWARD">
                                <Setter Property="Background" Value="#FAEEDA"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Type}" FontSize="{StaticResource CaptionSize}" FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="OUTWARD">
                                    <Setter Property="Foreground" Value="#E65100"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Stat Cards -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,30">
            <!-- Card 1 -->
            <Border Style="{StaticResource CardBorder}" BorderThickness="4,1,1,1" BorderBrush="{StaticResource AccentBlueBrush}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TODAY INWARD" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="valTodayInward" Text="{Binding TodayInward}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            
            <!-- Card 2 -->
            <Border Style="{StaticResource CardBorder}" BorderThickness="4,1,1,1" BorderBrush="{StaticResource SuccessBrush}" Margin="8,0,8,0">
                <StackPanel>
                    <TextBlock Text="TODAY OUTWARD" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="valTodayOutward" Text="{Binding TodayOutward}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            
            <!-- Card 3 -->
            <Border Style="{StaticResource CardBorder}" BorderThickness="4,1,1,1" BorderBrush="{StaticResource NavyDarkBrush}" Margin="8,0,8,0">
                <StackPanel>
                    <TextBlock Text="CURRENT STOCK" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="valTotalStock" Text="{Binding TotalStock}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card 4 -->
            <Border Style="{StaticResource CardBorder}" BorderThickness="4,1,1,1" BorderBrush="{StaticResource DangerBrush}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="TOTAL REWORKS" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="valTotalReworks" Text="{Binding ReworkCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Section Title -->
        <TextBlock Grid.Row="1" Text="Recent Transactions" FontSize="{StaticResource SectionSize}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

        <!-- Transactions Grid -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <DataGrid ItemsSource="{Binding RecentTransactions}" Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Type" CellTemplate="{StaticResource TypeColumnTemplate}" Width="100"/>
                    <DataGridTextColumn Header="Part No" Binding="{Binding PartNo}" Width="150"/>
                    <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="200"/>
                    <DataGridTextColumn Header="Rework Code" Binding="{Binding DefectCode}" Width="120"/>
                    <DataGridTextColumn Header="Scan Date" Binding="{Binding ScanDate, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="150"/>
                    <DataGridTextColumn Header="Scanned By" Binding="{Binding ScannedBy}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
